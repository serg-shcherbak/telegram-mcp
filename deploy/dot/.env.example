# Private host file, outside the checkout, mode 0600. Replace all placeholders.
TELEGRAM_API_ID=REPLACE_WITH_API_ID
TELEGRAM_API_HASH=REPLACE_WITH_API_HASH
TELEGRAM_SESSION_NAME=/app/session/telegram
DOT_ACCESS_CONFIG=/app/config/access.json
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8765
TELEGRAM_SESSION_LOCK=exclusive
TELEGRAM_LEGACY_EVENTS=0
TELEGRAM_EVENT_FEED=0
TELEGRAM_WARM_ENTITY_CACHE=0
TELEGRAM_SERVER_ROOTS_ONLY=1
TELEGRAM_TRANSCRIBE=on-demand
# ASR stays unavailable until external_asr scope is explicitly granted and this key is set.
# Use a provider API key here, not the tunnel runtime credential.
TELEGRAM_TRANSCRIBE_ENGINE=openai
TELEGRAM_TRANSCRIBE_OPENAI_URL=https://api.openai.com/v1
TELEGRAM_TRANSCRIBE_OPENAI_MODEL=gpt-transcribe
TELEGRAM_TRANSCRIBE_OPENAI_API_KEY=
TELEGRAM_TRANSCRIPT_CACHE_DIR=/app/state/transcripts
# Shared only with the network-isolated converter; never place this under media_root.
TELEGRAM_AUDIO_SCRATCH_DIR=/app/state/audio
# Applies to cached/job text; zero keeps job text only in memory, metadata remains.
TELEGRAM_TRANSCRIPT_RETENTION_SECONDS=604800
